{
  "name": "dsh-local-proxy-own",
  "version": "0.2.0",
  "description": "Local proxy core for DeepSeek Harness: loopback-only SOCKS5+HTTP funnel, self-contained sing-box node pool (URI parsing, live latency racing, hot reload on a fixed port, split routing), PAC generation and per-process proxy injection. System proxy is only touched on explicit request and restored to its exact pre-start state on stop.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "hysteria2",
    "local",
    "node-pool",
    "pac",
    "proxy",
    "sing-box",
    "socks5",
    "split-routing",
    "vmess"
  ],
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src",
    "bin/*.js",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "icon.png",
    "icon.svg",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "immediately": true,
      "platform": "web"
    }
  },
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtcjwm/dsh-local-proxy-own.git"
  },
  "homepage": "https://github.com/jtcjwm/dsh-local-proxy-own#readme",
  "bugs": {
    "url": "https://github.com/jtcjwm/dsh-local-proxy-own/issues"
  },
  "author": "jtcjwm",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "private": true
}
